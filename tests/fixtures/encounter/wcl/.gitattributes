# Recorded WarcraftLogs pages are large; store each real report directory in Git LFS.
# SYNTH01 is generated by build_synth.py and stays in plain git so its diffs are reviewable.
*/** filter=lfs diff=lfs merge=lfs -text
SYNTH01/** !filter !diff !merge text=auto
# Recorded search answers (server list, guild headers) are small JSON: plain git, so offline tests need no LFS pull.
_search/** !filter !diff !merge text=auto
