{
  "uid": "khadbot-service",
  "title": "KhadBot service",
  "description": "API requests, errors, warnings and outbound WCL and model calls, from Loki.",
  "tags": [
    "khadbot"
  ],
  "editable": true,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "timezone": "utc",
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "env",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "env",
          "stream": "",
          "type": 1,
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(env)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "API requests (event http.request)",
      "id": 1,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Requests per minute by route",
      "description": "One http.request line per API request, grouped by the route template.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (route) (count_over_time({service=\"api\", env=~\"$env\"} | event=\"http.request\" [1m]))",
          "editorMode": "code",
          "queryType": "range",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "5xx rate",
      "description": "Share of http.request lines with status 500 or above. The alert fires above 2% over 5 minutes.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum(count_over_time({service=\"api\", env=~\"$env\"} | event=\"http.request\" | json status=\"status\" | __error__=\"\" | status >= 500 [$__auto])) / sum(count_over_time({service=\"api\", env=~\"$env\"} | event=\"http.request\" [$__auto]))",
          "editorMode": "code",
          "queryType": "range",
          "legendFormat": "5xx share"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "p50 and p95 duration by route",
      "description": "duration_ms of http.request lines, per route template.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "quantile_over_time(0.5, {service=\"api\", env=~\"$env\"} | event=\"http.request\" | json duration_ms=\"duration_ms\" | __error__=\"\" | unwrap duration_ms [$__auto]) by (route)",
          "editorMode": "code",
          "queryType": "range",
          "legendFormat": "{{route}} p50"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "B",
          "expr": "quantile_over_time(0.95, {service=\"api\", env=~\"$env\"} | event=\"http.request\" | json duration_ms=\"duration_ms\" | __error__=\"\" | unwrap duration_ms [$__auto]) by (route)",
          "editorMode": "code",
          "queryType": "range",
          "legendFormat": "{{route}} p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 16,
        "h": 8
      }
    },
    {
      "type": "bargauge",
      "title": "error_code counts",
      "description": "Lines carrying an error_code over the time range: failed requests (http.request) and failed jobs (job.finish and job.settled), by service.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (service, error_code) (count_over_time({env=~\"$env\"} | error_code!=\"\" [$__range]))",
          "editorMode": "code",
          "queryType": "instant",
          "legendFormat": "{{service}} {{error_code}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "id": 5,
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "Warnings and errors",
      "id": 6,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "logs",
      "title": "WARNING and above, every service",
      "description": "Every KhadBot service's lines at WARNING, ERROR or CRITICAL. Third-party services (postgres, seaweedfs) send text without a level label and are not shown.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{env=~\"$env\", level=~\"WARNING|ERROR|CRITICAL\"}",
          "editorMode": "code",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending",
        "prettifyLogMessage": false
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 12
      }
    },
    {
      "type": "row",
      "title": "Outbound calls",
      "id": 8,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "WCL requests by op (DEBUG level only)",
      "description": "wcl.request lines by GraphQL operation. Successful requests log at DEBUG, so this counts every request only where KHADBOT_LOG_LEVEL is DEBUG; at the default INFO it shows failures (WARNING) alone. WCL points are on the spend dashboard.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (op) (count_over_time({env=~\"$env\"} | event=\"wcl.request\" | json op=\"op\" [$__auto]))",
          "editorMode": "code",
          "queryType": "range",
          "legendFormat": "{{op}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "WCL request failures by op",
      "description": "wcl.request lines at WARNING: a failed HTTP request (status, timeout or connection error).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (op) (count_over_time({env=~\"$env\", level=\"WARNING\"} | event=\"wcl.request\" | json op=\"op\" [$__auto]))",
          "editorMode": "code",
          "queryType": "range",
          "legendFormat": "{{op}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
