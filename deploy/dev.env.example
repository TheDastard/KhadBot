# Environment for the native dev loop (mise run dev:all): the API and worker run on your machine and reach the
# stack's Postgres and SeaweedFS through the ports compose publishes on 127.0.0.1. `scripts/dev/setup.ps1` copies this
# file to deploy/dev.env (gitignored) when that doesn't exist; edit the copy, not this example.
#
# Throwaway local values, the same ones as deploy/stack.env but with 127.0.0.1 for the container host names (not
# "localhost": on Windows the Postgres pool stalls on its IPv6 attempt first).
# Nothing real belongs here. Values in dev.env win over the same names in .env; every name not set here
# (LLM_PROVIDER, ANALYST_MODEL, WARCRAFTLOGS_CLIENT_ID and _SECRET, ...) still comes from the main checkout's .env.

KHADBOT_MODE=hosted
DATABASE_URL=postgresql://khadbot:local-stack-only@127.0.0.1:5432/khadbot
KHADBOT_STORAGE=s3
KHADBOT_S3_BUCKET=khadbot
KHADBOT_S3_ENDPOINT=http://127.0.0.1:8333
KHADBOT_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=khadbot-local
AWS_SECRET_ACCESS_KEY=local-stack-only-secret

# Sign-in. The callback is registered with Warcraft Logs for http://localhost:8000, so the API must run on port 8000.
# Real sign-in needs your own WARCRAFTLOGS_CLIENT_ID and _SECRET in .env; without them the dev loop falls back to
# placeholders, which run everything except signing in to Warcraft Logs. Do not put real credentials in this file.
KHADBOT_TOKEN_KEYS=VOE_A5LrGZqB3J5MWl2sCzjk5GqG0lzvkZxzP5pNf1w=
KHADBOT_WCL_REDIRECT_URI=http://localhost:8000/v1/auth/callback
KHADBOT_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Test sessions (development only): lets `mise run dev:session` and the seed's smoke user start sessions without a
# Warcraft Logs login. Only the local stack's and dev loop's env files and CI turn it on; production never does.
KHADBOT_TEST_SESSIONS=1
