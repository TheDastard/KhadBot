# Environment for the local compose stack (deploy/compose.yaml): every service reads this one file.
#
# These are throwaway values for a stack that listens on 127.0.0.1 only. They are not secrets, and nothing real
# belongs here: never put a production database URL, bucket key or WCL secret in this file. Real deployments set
# their own environment on the platform.

# Postgres container
POSTGRES_USER=khadbot
POSTGRES_PASSWORD=local-stack-only
POSTGRES_DB=khadbot

# KhadBot (api, worker, migrate, seed, queue-smoke). The worker's own settings (KHADBOT_WORKER_QUEUES and the
# others in docs/hosting.md) have working defaults.
KHADBOT_MODE=hosted
DATABASE_URL=postgresql://khadbot:local-stack-only@postgres:5432/khadbot
KHADBOT_STORAGE=s3
KHADBOT_S3_BUCKET=khadbot
KHADBOT_S3_ENDPOINT=http://seaweedfs:8333
KHADBOT_S3_REGION=us-east-1
# boto3 reads these standard variables; the SeaweedFS container also builds its one S3 identity from them.
AWS_ACCESS_KEY_ID=khadbot-local
AWS_SECRET_ACCESS_KEY=local-stack-only-secret

# Sign-in (the API). Throwaway: the key encrypts nothing real, and the WCL credentials are placeholders (the stack makes
# no WCL calls). Signing in to Warcraft Logs from the stack needs your own client in .env on a host run, not here.
WARCRAFTLOGS_CLIENT_ID=local-stack-client-id
WARCRAFTLOGS_CLIENT_SECRET=local-stack-client-secret
KHADBOT_TOKEN_KEYS=VOE_A5LrGZqB3J5MWl2sCzjk5GqG0lzvkZxzP5pNf1w=
KHADBOT_WCL_REDIRECT_URI=http://localhost:8000/v1/auth/callback
KHADBOT_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Read only by the seed: the cookie value of the smoke user's session (scripts/dev/stack_smoke.py). Never set outside this file.
KHADBOT_STACK_SMOKE_SESSION=local-stack-smoke-session
