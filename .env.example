# --- LLM Backend ---
# Set LLM_PROVIDER to one of: anthropic | openai | groq | ollama
#
# Provider guide:
#   anthropic — Claude Sonnet; best answer quality; use for quality eval runs
#   openai    — GPT-4o; alternative production model
#   groq      — Llama 3.3 70B, free tier; use for integration tests
#   ollama    — Local model (qwen3.5 recommended); use for inner dev loop (free)
#
# LLM Model is optional — each provider has a sensible default (see llm_factory.py).
# Override it here to pin a specific model version.

# LLM_PROVIDER=anthropic
# LLM_PROVIDER=openai
# LLM_PROVIDER=groq
LLM_PROVIDER=ollama

# ANTHROPIC_MODEL=claude-sonnet-4-20250514  # Anthropic default
# OPENAI_MODEL=gpt-4o                       # OpenAI default
# GROQ_MODEL=llama-3.3-70b-versatile        # Groq default
# GROQ_MODEL=llama-3.1-8b-instant           # Groq fast/cheap — scaffolding tests only
OLLAMA_MODEL=qwen3:8b                     # Ollama default (recommended for tool use)
# OLLAMA_MODEL=llama3.1                     # Ollama alternative

# --- API Keys ---
# Anthropic (https://console.anthropic.com)
# ANTHROPIC_API_KEY=your-anthropic-key-here

# OpenAI (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=your-openai-key-here

# Groq — free tier, sign up at https://console.groq.com
# GROQ_API_KEY=your-groq-key-here

# --- Ollama (local) ---
# Ollama runs on localhost by default. Override if running on a remote host.
# Requires: `ollama serve` running and model pulled: `ollama pull qwen2.5`
OLLAMA_BASE_URL=http://localhost:11434

# --- WarcraftLogs ---
WARCRAFTLOGS_CLIENT_ID=your-wcl-client-id
WARCRAFTLOGS_CLIENT_SECRET=your-wcl-client-secret

# --- Persona ---
# Set KHADBOT_PERSONA to one of: khadgar | thrall | xalatath
KHADBOT_PERSONA=khadgar

# --- LangSmith ---
# LANGCHAIN_TRACING_V2=true
# LANGSMITH_API_KEY=your-langsmith-key-here
# LANGSMITH_PROJECT=KhadBot

# --- Encounter review ---
# Where raw WCL pages, parquet events and sqlite stores live (default .khadbot_data/)
# KHADBOT_DATA_DIR=.khadbot_data
# Per-role LLM overrides (fall back to LLM_PROVIDER / provider default model)
# LLM_PROVIDER_ANALYST=anthropic
# LLM_PROVIDER_CONVERSATION=groq
# ANALYST_MODEL=
# CONVERSATION_MODEL=

# --- Hosted mode (sign-in with Warcraft Logs) ---
# Local mode has no sign-in and needs none of these. The WCL client (https://www.warcraftlogs.com/api/clients/)
# must list KHADBOT_WCL_REDIRECT_URI exactly as a redirect URL; WARCRAFTLOGS_CLIENT_ID/SECRET above are reused.
# KHADBOT_TOKEN_KEYS encrypts stored WCL tokens: comma-separated Fernet keys, newest first (older keys only decrypt,
# for rotation). Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KHADBOT_TOKEN_KEYS=
# KHADBOT_WCL_REDIRECT_URI=http://localhost:8000/v1/auth/callback
# KHADBOT_POST_LOGIN_URL=http://localhost:3000
# KHADBOT_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# KHADBOT_WCL_SCOPE=
# KHADBOT_SESSION_IDLE_HOURS=336
# KHADBOT_SESSION_MAX_DAYS=30
# KHADBOT_ACCESS_RECHECK_S=3600
# KHADBOT_ACCESS_DENIED_RECHECK_S=300

# --- Hosted mode (Postgres) ---
# Local mode (the default) needs none of these. `python main.py migrate` builds the schema.
# KHADBOT_MODE=hosted
# DATABASE_URL=postgresql://khadbot:change-me@localhost:5432/khadbot
# KHADBOT_DB_POOL_MIN=1
# KHADBOT_DB_POOL_MAX=10

# --- Hosted mode (object storage) ---
# Local mode (the default) keeps blobs under KHADBOT_DATA_DIR. KHADBOT_STORAGE=s3 puts them in a bucket on any
# S3-compatible service (Cloudflare R2 in production, SeaweedFS locally) and stores the raw WCL pages zstd-compressed. The bucket must exist.
# Credentials are the standard AWS variables (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY), not KhadBot settings.
# KHADBOT_STORAGE=s3
# KHADBOT_S3_BUCKET=khadbot
# KHADBOT_S3_PREFIX=
# KHADBOT_S3_ENDPOINT=http://localhost:8333
# KHADBOT_S3_REGION=auto

# --- Hosted mode (job queue worker) ---
# `python main.py worker` takes ingest, process and review jobs from Postgres. All optional; docs/hosting.md has the details.
# KHADBOT_WORKER_QUEUES=ingest,process,review,watch
# KHADBOT_WORKER_CONCURRENCY=2
# KHADBOT_WORKER_SHUTDOWN_TIMEOUT_S=60
# KHADBOT_JOB_MAX_RETRIES=5
# KHADBOT_JOB_RETRY_BACKOFF_S=3
# KHADBOT_JOB_PROGRESS_INTERVAL_S=0.5

# --- Hosted mode (API) ---
# `python main.py api` in hosted mode also needs the sign-in settings above and the WCL client credentials. CORS allows
# KHADBOT_WEB_ORIGINS with credentials. Optional; docs/hosting.md has the details.
# KHADBOT_SSE_KEEPALIVE_S=15

# --- Hosted mode (local container stack) ---
# `mise run stack:up` starts Postgres, SeaweedFS (the local S3 store) and the API from deploy/compose.yaml. Every service there reads
# deploy/stack.env, which holds throwaway local values; this file is not used by the stack and is never copied into
# an image. The variables are the same ones documented in docs/hosting.md.
# To run the API and worker on your machine against the stack's Postgres and bucket (`mise run dev:all`), the same
# names are read from deploy/dev.env, which scripts/dev/setup.ps1 copies from deploy/dev.env.example. Set nothing
# hosted here: dev.env wins over this file for the names it sets, and this file still supplies WARCRAFTLOGS_CLIENT_ID
# and _SECRET (real sign-in), LLM_PROVIDER and the model settings to the dev loop.

# --- Hosted mode (retention) ---
# `python scripts/data/apply_bucket_lifecycle.py` sets bucket rules that expire raw/ and annotated/ objects. The worker's
# cleanup job deletes records/ objects that no read-model row references once they are old enough. docs/hosting.md has the details.
# KHADBOT_RETENTION_RAW_DAYS=14
# KHADBOT_RETENTION_ANNOTATED_DAYS=90
# KHADBOT_RECORDS_MIN_AGE_DAYS=30
# KHADBOT_RECORDS_CLEANUP_CRON=17 3 * * *

# --- Hosted mode (WCL budget) ---
# Workers share the app's WCL points through one budget: an online ingest reserves its estimate before it runs,
# waits (job state waiting_budget) when it can't, and settles to its measured spend. All optional; the numbers and
# their sources are in docs/hosting.md. KHADBOT_WCL_LIMIT_SCHEME=new once the WCL account opts in to the new limits.
# KHADBOT_WCL_LIMIT_SCHEME=current
# KHADBOT_BUDGET_USER_TOKENS_SPEND_APP=true
# KHADBOT_BUDGET_GUILD_SHARE=0.25
# KHADBOT_BUDGET_USER_SHARE=0.10
# KHADBOT_BUDGET_HEADROOM_SHARE=0.20
# KHADBOT_BUDGET_POINTS_PER_PULL=7.2
# KHADBOT_BUDGET_POINTS_PER_SINGLE_PULL=14
# KHADBOT_BUDGET_POINTS_PER_JOB=4
# KHADBOT_BUDGET_DEFAULT_PULLS=25
# KHADBOT_BUDGET_DATABASE_POINTS_PER_HOUR=250
# KHADBOT_BUDGET_USER_POINTS_PER_HOUR=
# KHADBOT_BUDGET_RESERVATION_TTL_S=7200

# --- Hosted mode (live report watch) ---
# A signed-in user can watch a report that is still being logged: the worker reads its metadata every few minutes on
# the user's WCL token and ingests each new boss fight. All optional; docs/hosting.md has the details.
# KHADBOT_WATCH_POLL_INTERVAL_S=180
# KHADBOT_WATCH_QUIET_PERIOD_S=2700
# KHADBOT_WATCH_MAX_LENGTH_S=21600
# KHADBOT_WATCH_POLL_POINTS=1
# KHADBOT_WATCH_MAX_FAILURES=5

# --- Hosted mode (usage ledger and logging) ---
# Every ingest's WCL points and every model call's tokens are written to the usage table; `python main.py usage
# --since 2026-10-01 [--by user|guild|kind]` prints totals. Logs are JSON lines on stdout. A worker touches a health
# file that `python main.py worker --check` tests. docs/hosting.md has the details.
# KHADBOT_LOG_FORMAT=json
# KHADBOT_LOG_LEVEL=INFO
# KHADBOT_WORKER_HEALTH_FILE=
# KHADBOT_WORKER_HEARTBEAT_S=10
# KHADBOT_WORKER_STALE_S=60

# --- Test sessions (development only) ---
# Lets `python main.py test-session` start a session for a named test user without a Warcraft Logs login. Off unless
# set. Only the local stack's and CI's environment files turn it on; staging only for the load test; production never.
# KHADBOT_TEST_SESSIONS=1
