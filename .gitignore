# =============================================================================
# KhadBot — Agentic WoW Assistant
# Python 3.14+ | Windows primary | VSCode
# =============================================================================


# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[codz]
*$py.class
*.so
*.pyd

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
MANIFEST
wheels/

# Type checkers & linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Test & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/

# Cython
cython_debug/


# -----------------------------------------------------------------------------
# Environments
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
/deploy/dev.env
.envrc
.venv/
venv/
env/


# -----------------------------------------------------------------------------
# VSCode
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# Shared workspace settings are fine to commit; personal ones aren't
# If your team uses different formatter settings, move settings.json here too


# -----------------------------------------------------------------------------
# Encounter review local data (raw WCL pages, parquet events, sqlite stores)
# -----------------------------------------------------------------------------
.khadbot_data/
.khadbot_fixture_data/
# The dev loop's JSON log files, tailed by the obs profile's Alloy
.khadbot_dev_logs/

# Claude Code task worktrees
# -----------------------------------------------------------------------------
.claude/worktrees/


# -----------------------------------------------------------------------------
# TypeScript workspace (apps/, packages/)
# -----------------------------------------------------------------------------
node_modules/
.next/
next-env.d.ts
*.tsbuildinfo
playwright-report/
playwright-report-local/
test-results/
# Playwright storage-state files hold live test-session cookies
apps/web/e2e/.auth/
